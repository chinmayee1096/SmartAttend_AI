# Optional database path override. The default is data/smartattend.sqlite3.
SMARTATTEND_DB=data/smartattend.sqlite3

# IANA timezone used for timetable matching and all attendance timestamps.
SMARTATTEND_TIMEZONE=Asia/Kolkata

# SMTP credentials are entered in the application's Email Alerts page and are
# retained only for the active Streamlit session. Never add real credentials here.
